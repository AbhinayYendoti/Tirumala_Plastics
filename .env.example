# ─── Database: Neon (Singapore, ap-southeast-1) ───
# Neon → Project → Connect → pooled connection string ("-pooler" in the host).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Auth: Clerk ───
# Clerk → API keys. Use pk_live_/sk_live_ keys from a production instance when you deploy.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

# ─── Access ───
# Only these emails can open the register (comma separated). Leave empty only for local testing.
ALLOWED_EMAILS="owner@example.com,father@example.com"
